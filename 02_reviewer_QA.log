. ********************************************************************************
. * II-3. HELPER PROGRAM: POST COEFFICIENTS FROM THE MOST RECENT MODEL
. ********************************************************************************
. 
. capture program drop qa_post_estimates

. program define qa_post_estimates
  1.     version 18
  2.     syntax, HANDLE(name) OUTCOME(string asis) ANALYSIS(string asis) ///
>         ADJUSTMENT(string asis) VARS(varlist)
  3. 
.     local model_n = e(N)
  4.     local model_r2 = e(r2)
  5.     local model_df = e(df_r)
  6. 
.     foreach v of local vars {
  7.         capture local b = _b[`v']
  8.         if !_rc {
  9.             local se = _se[`v']
 10.             local tstat = `b' / `se'
 11.             local pval = 2 * ttail(`model_df', abs(`tstat'))
 12.             local crit = invttail(`model_df', 0.025)
 13.             local lo = `b' - `crit' * `se'
 14.             local hi = `b' + `crit' * `se'
 15.             local vlabel : variable label `v'
 16.             if `"`vlabel'"' == "" local vlabel "`v'"
 17. 
.             post `handle' (`"`outcome'"') (`"`analysis'"') ///
>                 (`"`adjustment'"') ("`v'") (`"`vlabel'"') ///
>                 (`b') (`se') (`lo') (`hi') (`pval') ///
>                 (`model_n') (`model_r2')
 18.         }
 19.     }
 20. end

. 
