 12.         local pooled_sd = sqrt((`s1'^2 + `s0'^2) / 2)
 13.         if (`pooled_sd' > 0) local smd = (`m1' - `m0') / `pooled_sd'
 14.     }
 15.     local abs_smd = abs(`smd')
 16.     local vlabel : variable label `v'
 17.     if `"`vlabel'"' == "" local vlabel "`v'"
 18. 
.     post `availpost' (`"`vlabel'"') ("Continuous") ///
