. foreach v of local missingness_vars {
  2.     quietly count
  3.     local total_n = r(N)
  4.     quietly count if !missing(`v')
  5.     local nonmissing_n = r(N)
  6.     local missing_n = `total_n' - `nonmissing_n'
  7.     local percent_missing = 100 * `missing_n' / `total_n'
  8.     local vlabel : variable label `v'
  9.     if `"`vlabel'"' == "" local vlabel "`v'"
 10.     post `misspost' ("`v'") (`"`vlabel'"') (`total_n') (`nonmissing_n') ///
>         (`missing_n') (`percent_missing')
 11. }

. postclose `misspost'

